# Copy to terraform.tfvars and adjust
nsx_host     = "nsx.lab.local"
nsx_username = "admin"
nsx_password = "change-me"

tier0_name = "t0-gw"
# locale_service_name = "default" # only if the Tier-0 has several locale services

# Existing Tier-0 uplink IPs to peer from (the "Source Addresses" in the NSX UI); empty = all uplinks
source_addresses = ["192.168.88.1"]

powerbgp_ip = "192.168.88.50"
powerbgp_as = "65000"
nsx_as      = "65003"

# TCP-MD5 password; needs PowerBGP on Linux (Start-BgpSession -Password). Omit for none.
# md5_key = "change-me"
